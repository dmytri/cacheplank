{
  "name": "cacheplank",
  "version": "0.1.5",
  "description": "The shared plank your pods walk across: a single-file Next.js 16 cache handler where entries stay local and only tag invalidation is shared, via one libSQL table.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cache-handler": {
      "types": "./dist/cache-handler.d.ts",
      "import": "./dist/cache-handler.mjs",
      "require": "./dist/cache-handler.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e-static-route.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "next": "16.3.8",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "next",
    "nextjs",
    "next.js",
    "cache-handler",
    "cacheComponents",
    "use-cache",
    "isr",
    "revalidateTag",
    "libsql",
    "turso",
    "bunny"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmytri/cacheplank.git"
  }
}
